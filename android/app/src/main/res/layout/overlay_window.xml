<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded: Dynamic Island style — centered top capsule -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_pill_progress"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:minWidth="180dp"
    android:elevation="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Pulsing state dot -->
    <View
        android:id="@+id/pill_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_overlay_dot" />

    <!-- Real-time status text (marquee scrolls when it doesn't fit) -->
    <TextView
        android:id="@+id/pill_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/overlay_running"
        android:textColor="@color/on_surface_medium"
        android:textSize="10sp"
        android:maxWidth="160dp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:fontFamily="sans-serif" />

</LinearLayout>
