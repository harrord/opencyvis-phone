<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface"
    android:fitsSystemWindows="true">

    <!-- Top bar: close + character count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <Button
            android:id="@+id/btn_fullscreen_close"
            style="@style/OpenCyvis.Button.Custom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textSize="16sp"
            android:textColor="@color/on_surface_medium"
            android:background="@drawable/bg_action_btn"
            android:padding="0dp"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/text_char_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0"
            android:textSize="13sp"
            android:textColor="@color/on_surface_hint"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Full-screen multi-line editor -->
    <EditText
        android:id="@+id/edit_fullscreen_input"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:hint="Type your instructions here..."
        android:inputType="textMultiLine"
        android:background="@null"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:textSize="16sp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/on_surface_hint"
        android:fontFamily="sans-serif" />

    <!-- Bottom send bar -->
    <Button
        android:id="@+id/btn_fullscreen_send"
        style="@style/OpenCyvis.Button.Custom"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="Send"
        android:textSize="15sp"
        android:textColor="@color/surface"
        android:background="@drawable/bg_btn_send"
        android:textStyle="bold"
        android:stateListAnimator="@null" />
</LinearLayout>
